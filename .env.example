APP_NAME=SmartBusiness
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartbusiness
DB_USERNAME=smartbusiness
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Configuración de correo:
# 1. Desarrollo local: MAIL_MAILER=log
# 2. Resend (vía API o SMTP):
#    - Opción Resend SMTP:
#      MAIL_MAILER=smtp
#      MAIL_HOST=smtp.resend.com
#      MAIL_PORT=465
#      MAIL_ENCRYPTION=tls
#      MAIL_USERNAME=resend
#      MAIL_PASSWORD=re_tu_api_key_aqui
#    - Opción Resend nativo:
#      MAIL_MAILER=resend
#      RESEND_API_KEY=re_tu_api_key_aqui
# 3. SMTP estándar (Gmail, Mailgun, Sendgrid, Brevo):
#      MAIL_MAILER=smtp
#      MAIL_HOST=smtp.tuservidor.com
#      MAIL_PORT=587
#      MAIL_ENCRYPTION=tls
#      MAIL_USERNAME=tu_usuario
#      MAIL_PASSWORD=tu_password
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@smartbusiness.test
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=